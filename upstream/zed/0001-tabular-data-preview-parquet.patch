@@ -0,0 +1,456 @@
+//! Decodes Parquet bytes into plain strings for display.
+//!
+//! Kept free of GPUI types so it can be unit-tested in isolation.
+
+use anyhow::{Context as _, Result};
+use bytes::Bytes;
+use chrono::DateTime;
+use parquet::file::reader::{FileReader, SerializedFileReader};
+use parquet::record::Field;
+
+pub(crate) struct DecodedParquet {
+    pub headers: Vec<String>,
+    pub rows: Vec<Vec<String>>,
+    /// Row count from the file footer, or `None` if the footer's count is invalid.
+    pub total_rows: Option<usize>,
+    /// Whether rows remained after `max_rows`, observed while reading rather than taken from
+    /// the footer, which may disagree with the row groups.
+    pub truncated: bool,
+}
+
+pub(crate) struct DecodeLimits {
+    pub max_rows: usize,
+    /// Upper bound on the uncompressed size, per the footer, of the row groups that would be
+    /// read to produce `max_rows` rows. Checked before decoding so dense files fail fast; the
+    /// footer isn't verified, so `max_decoded_text_bytes` backs it up during decoding.
+    pub max_uncompressed_bytes: u64,
+    /// Upper bound on the text actually produced for the table, enforced row by row.
+    pub max_decoded_text_bytes: u64,
+}
+
+/// Decodes at most `limits.max_rows` rows.
+pub(crate) fn decode_parquet(bytes: Bytes, limits: DecodeLimits) -> Result<DecodedParquet> {
+    let DecodeLimits {
+        max_rows,
+        max_uncompressed_bytes,
+        max_decoded_text_bytes,
+    } = limits;
+    let reader = SerializedFileReader::new(bytes).context("not a valid Parquet file")?;
+
+    let mut rows_covered = 0usize;
+    let mut uncompressed_bytes = 0u64;
+    for row_group in reader.metadata().row_groups() {
+        if rows_covered >= max_rows {
+            break;
+        }
+        // Without valid sizes the decode cost can't be bounded up front, so refuse the file.
+        let (Ok(group_rows), Ok(group_bytes)) = (
+            usize::try_from(row_group.num_rows()),
+            u64::try_from(row_group.total_byte_size()),
+        ) else {
+            anyhow::bail!("the file's row group metadata is invalid");
+        };
+        rows_covered = rows_covered.saturating_add(group_rows);
+        uncompressed_bytes = uncompressed_bytes.saturating_add(group_bytes);
+    }
+    anyhow::ensure!(
+        uncompressed_bytes <= max_uncompressed_bytes,
+        "the rows to preview would take {} MB to decode, over the {} MB limit",
+        uncompressed_bytes / (1024 * 1024),
+        max_uncompressed_bytes / (1024 * 1024)
+    );
+
+    let file_metadata = reader.metadata().file_metadata();
+    let total_rows = usize::try_from(file_metadata.num_rows()).ok();
+    let headers = file_metadata
+        .schema_descr()
+        .root_schema()
+        .get_fields()
+        .iter()
+        .map(|field| field.name().to_string())
+        .collect::<Vec<_>>();
+
+    let mut rows = Vec::with_capacity(total_rows.unwrap_or(0).min(max_rows));
+    let mut decoded_text_bytes = 0u64;
+    let mut row_iter = reader.get_row_iter(None)?;
+    for row in row_iter.by_ref().take(max_rows) {
+        let row = row.context("reading Parquet row")?;
+        let values = row
+            .get_column_iter()
+            .map(|(_, field)| field_text(field))
+            .collect::<Vec<_>>();
+        decoded_text_bytes = values.iter().fold(decoded_text_bytes, |total, value| {
+            total.saturating_add(value.len() as u64)
+        });
+        anyhow::ensure!(
+            decoded_text_bytes <= max_decoded_text_bytes,
+            "the decoded rows exceed the {} MB preview limit",
+            max_decoded_text_bytes / (1024 * 1024)
+        );
+        rows.push(values);
+    }
+
+    let truncated = row_iter.next().is_some();
+
+    Ok(DecodedParquet {
+        headers,
+        rows,
+        total_rows,
+        truncated,
+    })
+}
+
+fn field_text(field: &Field) -> String {
+    match field {
+        Field::Null => String::new(),
+        Field::Str(value) => value.clone(),
+        Field::Group(_) | Field::ListInternal(_) | Field::MapInternal(_) => nested_text(field, 0),
+        // `Field`'s Display switches to scientific notation outside 1e-15..=1e19, which
+        // renders 0.0 as "0E0" and every negative number as e.g. "-1.5E0".
+        Field::Float16(value) => value.to_string(),
+        Field::Float(value) => value.to_string(),
+        Field::Double(value) => value.to_string(),
+        Field::Bytes(value) => match std::str::from_utf8(value.data()) {
+            Ok(text) => text.to_string(),
+            Err(_) => format!("<{} bytes>", value.len()),
+        },
+        // `Field`'s Display unwraps these conversions, which panics on out-of-range values.
+        Field::Date(days) => DateTime::from_timestamp(i64::from(*days) * 86_400, 0)
+            .map(|date| date.format("%Y-%m-%d").to_string())
+            .unwrap_or_else(|| days.to_string()),
+        Field::TimestampMillis(millis) => DateTime::from_timestamp_millis(*millis)
+            .map(|time| time.format("%Y-%m-%d %H:%M:%S%.3f").to_string())
+            .unwrap_or_else(|| millis.to_string()),
+        Field::TimestampMicros(micros) => DateTime::from_timestamp_micros(*micros)
+            .map(|time| time.format("%Y-%m-%d %H:%M:%S%.6f").to_string())
+            .unwrap_or_else(|| micros.to_string()),
+        other => other.to_string(),
+    }
+}
+
+/// Nesting deeper than this is elided, so a pathological schema can't overflow the stack.
+const MAX_NESTING_DEPTH: usize = 64;
+
+/// Formats nested values ourselves rather than via `Field`'s Display, whose timestamp and
+/// date conversions unwrap and would abort Zed (its panic hook aborts) on out-of-range values.
+fn nested_text(field: &Field, depth: usize) -> String {
+    let is_nested = matches!(
+        field,
+        Field::Group(_) | Field::ListInternal(_) | Field::MapInternal(_)
+    );
+    if is_nested && depth >= MAX_NESTING_DEPTH {
+        return "…".to_string();
+    }
+    let child = |value: &Field| nested_text(value, depth + 1);
+    match field {
+        Field::Null => "null".to_string(),
+        Field::Str(value) => format!("{value:?}"),
+        Field::Group(row) => {
+            let fields = row
+                .get_column_iter()
+                .map(|(name, value)| format!("{name}: {}", child(value)))
+                .collect::<Vec<_>>();
+            format!("{{{}}}", fields.join(", "))
+        }
+        Field::ListInternal(list) => {
+            let elements = list.elements().iter().map(child).collect::<Vec<_>>();
+            format!("[{}]", elements.join(", "))
+        }
+        Field::MapInternal(map) => {
+            let entries = map
+                .entries()
+                .iter()
+                .map(|(key, value)| format!("{}: {}", child(key), child(value)))
+                .collect::<Vec<_>>();
+            format!("{{{}}}", entries.join(", "))
+        }
+        scalar => field_text(scalar),
+    }
+}
+
+#[cfg(test)]
+pub(crate) mod tests {
+    use super::*;
+    use parquet::basic::Compression;
+    use parquet::data_type::{ByteArray, ByteArrayType, DoubleType, Int64Type};
+    use parquet::file::properties::WriterProperties;
+    use parquet::file::writer::SerializedFileWriter;
+    use parquet::schema::parser::parse_message_type;
+    use std::sync::Arc;
+
+    fn limits(max_rows: usize) -> DecodeLimits {
+        DecodeLimits {
+            max_rows,
+            max_uncompressed_bytes: u64::MAX,
+            max_decoded_text_bytes: u64::MAX,
+        }
+    }
+
+    /// Writes `row_groups` row groups of `ids`, each with an id, a nullable name,
+    /// a nullable double, and a millisecond timestamp column.
+    pub(crate) fn sample_parquet(row_groups: &[&[i64]], compression: Compression) -> Bytes {
+        let schema = Arc::new(
+            parse_message_type(
+                "message sample {
+                    REQUIRED INT64 id;
+                    OPTIONAL BYTE_ARRAY name (UTF8);
+                    OPTIONAL DOUBLE score;
+                    REQUIRED INT64 seen (TIMESTAMP(MILLIS,true));
+                }",
+            )
+            .unwrap(),
+        );
+        let properties = Arc::new(
+            WriterProperties::builder()
+                .set_compression(compression)
+                .build(),
+        );
+        let mut buffer = Vec::new();
+        let mut writer = SerializedFileWriter::new(&mut buffer, schema, properties).unwrap();
+        for ids in row_groups {
+            let mut row_group = writer.next_row_group().unwrap();
+            let present = |id: &i64| i16::from(id % 3 != 0);
+
+            let mut column = row_group.next_column().unwrap().unwrap();
+            column
+                .typed::<Int64Type>()
+                .write_batch(ids, None, None)
+                .unwrap();
+            column.close().unwrap();
+
+            let mut column = row_group.next_column().unwrap().unwrap();
+            let names = ids
+                .iter()
+                .filter(|id| *id % 3 != 0)
+                .map(|id| ByteArray::from(format!("name, {id}").as_str()))
+                .collect::<Vec<_>>();
+            let levels = ids.iter().map(present).collect::<Vec<_>>();
+            column
+                .typed::<ByteArrayType>()
+                .write_batch(&names, Some(&levels), None)
+                .unwrap();
+            column.close().unwrap();
+
+            let mut column = row_group.next_column().unwrap().unwrap();
+            let scores = ids
+                .iter()
+                .filter(|id| *id % 3 != 0)
+                .map(|id| -(*id as f64) / 2.0)
+                .collect::<Vec<_>>();
+            column
+                .typed::<DoubleType>()
+                .write_batch(&scores, Some(&levels), None)
+                .unwrap();
+            column.close().unwrap();
+
+            let mut column = row_group.next_column().unwrap().unwrap();
+            let seen = ids
+                .iter()
+                .map(|id| 1_767_225_600_000 + id * 60_000)
+                .collect::<Vec<_>>();
+            column
+                .typed::<Int64Type>()
+                .write_batch(&seen, None, None)
+                .unwrap();
+            column.close().unwrap();
+
+            row_group.close().unwrap();
+        }
+        writer.close().unwrap();
+        Bytes::from(buffer)
+    }
+
