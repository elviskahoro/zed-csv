+        column.close().unwrap();
+
+        let mut column = row_group.next_column().unwrap().unwrap();
+        column
+            .typed::<ByteArrayType>()
+            .write_batch(
+                &[
+                    ByteArray::from("a"),
+                    ByteArray::from("b"),
+                    ByteArray::from("c"),
+                ],
+                Some(&[1, 1, 1]),
+                Some(&[0, 1, 0]),
+            )
+            .unwrap();
+        column.close().unwrap();
+
+        row_group.close().unwrap();
+        writer.close().unwrap();
+
+        let decoded = decode_parquet(Bytes::from(buffer), limits(10)).unwrap();
+        assert_eq!(decoded.headers, ["meta", "tags"]);
+        assert_eq!(
+            decoded.rows,
+            [
+                [
+                    "{tag: \"x\", at: 1970-01-01 00:00:00.000}".to_string(),
+                    "[\"a\", \"b\"]".to_string(),
+                ],
+                [
+                    format!("{{tag: \"y\", at: {}}}", i64::MAX),
+                    "[\"c\"]".to_string(),
+                ],
+            ]
+        );
+    }
+}
