+    #[test]
+    fn formats_nested_values_without_panicking() {
+        let schema = Arc::new(
+            parse_message_type(
+                "message nested {
+                    REQUIRED group meta {
+                        REQUIRED BYTE_ARRAY tag (UTF8);
+                        REQUIRED INT64 at (TIMESTAMP(MILLIS,true));
+                    }
+                    REQUIRED group tags (LIST) {
+                        REPEATED group list {
+                            REQUIRED BYTE_ARRAY element (UTF8);
+                        }
+                    }
+                }",
+            )
+            .unwrap(),
