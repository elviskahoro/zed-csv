@@ -0,0 +1,609 @@
+//! Opens `.parquet` files directly in a read-only [`TableView`].
+//!
+//! Parquet is binary, so the text-buffer path rejects it before the editor-backed
+//! [`crate::TabularDataPreviewPane`] could see it. Instead, [`ParquetItem`] claims the path
+//! as a project item, decodes it on a background thread, and [`ParquetView`] hands the
+//! result to the same table component the CSV preview uses.
+
+mod decode;
+
+use std::{path::Path, sync::Arc};
+
+use anyhow::{Context as _, Result};
+use bytes::Bytes;
+use gpui::{
+    App, AppContext as _, Context, Entity, EntityId, EventEmitter, FocusHandle, Focusable,
+    Subscription, Task, Window,
+};
+use project::{Fs, MTime, Project, ProjectEntryId, ProjectPath, Worktree};
+use ui::{SharedString, prelude::*, table_row::TableRow};
+use util::rel_path::RelPath;
+use workspace::{
+    Pane,
+    invalid_item_view::InvalidItemView,
+    item::{Item, ItemBufferKind, ProjectItem},
+};
+
+use crate::TableView;
+use crate::types::{LineNumber, TableCell, TableLikeContent};
+use decode::{DecodeLimits, DecodedParquet, decode_parquet};
+
+const PARQUET_EXTENSION: &str = "parquet";
+
+/// Rows beyond this are not decoded, which bounds the size of the table and the decode time.
+const MAX_ROWS: usize = 100_000;
+
+/// Limit on how much the previewed rows may decompress to, since highly compressible columns
+/// can expand far beyond the file size. Checked against the footer up front and against the
+/// text actually decoded as rows are read.
+const MAX_DECODED_BYTES: u64 = 1024 * 1024 * 1024;
+
+// The whole file is read into memory before decoding, so very large files are refused
+// rather than risking the editor's memory.
+#[cfg(not(test))]
+const MAX_FILE_BYTES: u64 = 512 * 1024 * 1024;
+#[cfg(test)]
+const MAX_FILE_BYTES: u64 = 64 * 1024;
+
+pub fn init(cx: &mut App) {
+    workspace::register_project_item::<ParquetView>(cx);
+}
+
+pub struct ParquetItem {
+    project_path: ProjectPath,
+    fs: Arc<dyn Fs>,
+    entry_id: Option<ProjectEntryId>,
+    content: Arc<TableLikeContent>,
+    total_rows: Option<usize>,
+    /// Whether more rows exist than were decoded.
+    truncated: bool,
+    /// Set when re-reading the file after a change on disk failed; the previous rows stay visible.
+    reload_error: Option<SharedString>,
+    reload_task: Option<Task<()>>,
+    _worktree_subscription: Subscription,
+}
+
+pub enum ParquetItemEvent {
+    Reloaded,
+}
+
+impl EventEmitter<ParquetItemEvent> for ParquetItem {}
+
+struct LoadedParquet {
+    entry_id: Option<ProjectEntryId>,
+    /// Modification time of the file as read, to detect changes that raced the initial open.
+    mtime: Option<MTime>,
+    content: TableLikeContent,
+    total_rows: Option<usize>,
+    /// Whether more rows exist than were decoded.
+    truncated: bool,
+}
+
+fn is_parquet_path(project: &Entity<Project>, path: &ProjectPath, cx: &App) -> bool {
+    let is_parquet = |extension: Option<&str>| {
+        extension.is_some_and(|ext| ext.eq_ignore_ascii_case(PARQUET_EXTENSION))
+    };
+    // Single-file worktrees have an empty relative path, so fall back to the absolute path.
+    is_parquet(path.path.extension())
+        || project
+            .read(cx)
+            .absolute_path(path, cx)
+            .is_some_and(|abs_path| is_parquet(abs_path.extension().and_then(|ext| ext.to_str())))
+}
+
+fn ensure_within_size_limit(size: u64) -> Result<()> {
+    anyhow::ensure!(
+        size <= MAX_FILE_BYTES,
+        "Parquet files larger than {:.1} MB can't be previewed (this one is {:.1} MB)",
+        megabytes(MAX_FILE_BYTES),
+        megabytes(size)
+    );
+    Ok(())
+}
+
+fn megabytes(bytes: u64) -> f64 {
+    bytes as f64 / (1024.0 * 1024.0)
+}
+
+fn load_parquet(
+    fs: Arc<dyn Fs>,
+    worktree: Entity<Worktree>,
+    path: Arc<RelPath>,
+    cx: &mut App,
+) -> Task<Result<LoadedParquet>> {
+    let abs_path = worktree.read(cx).absolutize(&path);
+    cx.spawn(async move |cx| {
+        // Ask the filesystem rather than the worktree snapshot, which may not have scanned the
+        // entry yet; an unknown size must not bypass the limit.
+        let size = fs
+            .metadata(&abs_path)
+            .await?
+            .with_context(|| format!("{} does not exist", abs_path.display()))?
+            .len;
+        ensure_within_size_limit(size)?;
+        let loaded = worktree
+            .update(cx, |worktree, cx| worktree.load_binary_file(&path, cx))
+            .await?;
+        // The file may have grown between the size check and the read.
+        ensure_within_size_limit(loaded.content.len() as u64)?;
+        let entry_id = loaded.file.entry_id;
+        let mtime = loaded.file.disk_state.mtime();
+        let (content, total_rows, truncated) = cx
+            .background_spawn(async move {
+                let decoded = decode_parquet(
+                    Bytes::from(loaded.content),
+                    DecodeLimits {
+                        max_rows: MAX_ROWS,
+                        max_uncompressed_bytes: MAX_DECODED_BYTES,
+                        max_decoded_text_bytes: MAX_DECODED_BYTES,
+                    },
+                )?;
+                let (total_rows, truncated) = (decoded.total_rows, decoded.truncated);
+                anyhow::Ok((table_content(decoded)?, total_rows, truncated))
+            })
+            .await
+            .context("decoding Parquet file")?;
+        Ok(LoadedParquet {
+            entry_id,
+            mtime,
+            content,
+            total_rows,
+            truncated,
+        })
+    })
+}
+
+impl ParquetItem {
+    fn new(
+        project_path: ProjectPath,
+        fs: Arc<dyn Fs>,
+        worktree: &Entity<Worktree>,
+        loaded: LoadedParquet,
+        cx: &mut Context<Self>,
+    ) -> Self {
+        let _worktree_subscription = cx.subscribe(worktree, |this, worktree, event, cx| {
+            if let worktree::Event::UpdatedEntries(changes) = event
+                && changes
+                    .iter()
+                    .any(|(path, _, _)| *path == this.project_path.path)
+            {
+                this.reload(worktree, cx);
+            }
+        });
+        let current_mtime = worktree
+            .read(cx)
+            .entry_for_path(&project_path.path)
+            .and_then(|entry| entry.mtime);
+        let mut this = Self {
+            project_path,
+            fs,
+            entry_id: loaded.entry_id,
+            content: Arc::new(loaded.content),
+            total_rows: loaded.total_rows,
+            truncated: loaded.truncated,
+            reload_error: None,
+            reload_task: None,
+            _worktree_subscription,
+        };
+        // The file may have changed between the read and the subscription above, in which case
+        // its change event was missed.
+        if current_mtime.is_some() && current_mtime != loaded.mtime {
+            this.reload(worktree.clone(), cx);
+        }
+        this
+    }
+
+    fn reload(&mut self, worktree: Entity<Worktree>, cx: &mut Context<Self>) {
+        let load = load_parquet(
+            self.fs.clone(),
+            worktree,
+            self.project_path.path.clone(),
+            cx,
+        );
+        // Replacing the task drops (and so cancels) any reload still in flight, so an older
+        // read can never land after a newer one.
+        self.reload_task = Some(cx.spawn(async move |this, cx| {
+            let loaded = load.await;
+            this.update(cx, |this, cx| {
+                match loaded {
+                    Ok(loaded) => {
+                        this.entry_id = loaded.entry_id;
+                        this.content = Arc::new(loaded.content);
+                        this.total_rows = loaded.total_rows;
+                        this.truncated = loaded.truncated;
+                        this.reload_error = None;
+                    }
+                    Err(error) => {
+                        this.reload_error = Some(format!("{error:#}").into());
+                    }
+                }
+                cx.emit(ParquetItemEvent::Reloaded);
+            })
+            .ok();
+        }));
+    }
+}
+
+impl project::ProjectItem for ParquetItem {
+    fn try_open(
+        project: &Entity<Project>,
+        path: &ProjectPath,
+        cx: &mut App,
+    ) -> Option<Task<Result<Entity<Self>>>> {
+        if !is_parquet_path(project, path, cx) {
+            return None;
+        }
+        let worktree = project.read(cx).worktree_for_id(path.worktree_id, cx)?;
+        // Remote worktrees can't load binary files yet; leave those paths to the default handler.
+        if !worktree.read(cx).is_local() {
+            return None;
+        }
+        let fs = project.read(cx).fs().clone();
+        let load = load_parquet(fs.clone(), worktree.clone(), path.path.clone(), cx);
+        let project_path = path.clone();
+
+        Some(cx.spawn(async move |cx| {
+            let loaded = load.await?;
+            Ok(cx.new(|cx| ParquetItem::new(project_path, fs, &worktree, loaded, cx)))
+        }))
+    }
+
+    fn entry_id(&self, _: &App) -> Option<ProjectEntryId> {
+        self.entry_id
+    }
+
+    fn project_path(&self, _: &App) -> Option<ProjectPath> {
+        Some(self.project_path.clone())
+    }
+
+    fn is_dirty(&self) -> bool {
+        false
+    }
+}
+
+fn table_content(decoded: DecodedParquet) -> Result<TableLikeContent> {
+    let number_of_cols = decoded.headers.len();
+    let to_row = |values: Vec<String>| {
+        let cells = values
+            .into_iter()
+            .map(|value| TableCell::Generated(value.into()))
+            .collect();
+        TableRow::try_from_vec(cells, number_of_cols).map_err(anyhow::Error::msg)
+    };
+    let line_numbers = (1..=decoded.rows.len()).map(LineNumber::Line).collect();
+    Ok(TableLikeContent {
+        number_of_cols,
+        headers: to_row(decoded.headers)?,
+        rows: decoded
+            .rows
+            .into_iter()
+            .map(to_row)
+            .collect::<Result<_>>()?,
+        line_numbers,
+    })
+}
+
+pub struct ParquetView {
+    item: Entity<ParquetItem>,
+    pub(crate) table: Entity<TableView>,
+    _item_subscription: Subscription,
+}
+
+impl ProjectItem for ParquetView {
+    type Item = ParquetItem;
+
+    fn for_project_item(
+        _project: Entity<Project>,
+        _pane: Option<&Pane>,
+        item: Entity<Self::Item>,
+        window: &mut Window,
+        cx: &mut Context<Self>,
+    ) -> Self {
+        let content = item.read(cx).content.clone();
+        let table = cx.new(|cx| {
+            let mut table = TableView::new(window, cx);
+            table.set_contents(content, cx);
+            table
+        });
+        let _item_subscription = cx.subscribe(&item, |this, item, event, cx| match event {
+            ParquetItemEvent::Reloaded => {
+                let content = item.read(cx).content.clone();
+                this.table
+                    .update(cx, |table, cx| table.set_contents(content, cx));
+                cx.notify();
+            }
+        });
+        Self {
+            item,
+            table,
+            _item_subscription,
+        }
+    }
+
+    fn for_broken_project_item(
+        abs_path: &Path,
+        is_local: bool,
+        e: &anyhow::Error,
+        window: &mut Window,
+        cx: &mut App,
+    ) -> Option<InvalidItemView> {
+        Some(InvalidItemView::new(abs_path, is_local, e, window, cx))
+    }
+}
+
+impl EventEmitter<()> for ParquetView {}
+
+impl Focusable for ParquetView {
+    fn focus_handle(&self, cx: &App) -> FocusHandle {
+        self.table.read(cx).focus_handle(cx)
+    }
+}
+
+impl Render for ParquetView {
+    fn render(&mut self, _window: &mut Window, cx: &mut Context<Self>) -> impl IntoElement {
+        let item = self.item.read(cx);
+        let shown_rows = item.content.rows.len();
+        let truncation_notice = item.truncated.then(|| match item.total_rows {
+            Some(total_rows) if total_rows > shown_rows => {
+                format!("Showing the first {shown_rows} of {total_rows} rows")
+            }
+            _ => format!("Showing the first {shown_rows} rows"),
+        });
+        let notice = |text: SharedString, color: Color| {
+            h_flex()
+                .px_2()
+                .py_1()
+                .child(Label::new(text).size(LabelSize::Small).color(color))
+        };
+        v_flex()
+            .size_full()
+            .when_some(item.reload_error.clone(), |this, error| {
+                this.child(notice(
+                    format!("Showing the last successfully read version: {error}").into(),
+                    Color::Error,
+                ))
+            })
+            .when_some(truncation_notice, |this, text| {
+                this.child(notice(text.into(), Color::Muted))
+            })
+            .child(self.table.clone())
+    }
+}
+
+impl Item for ParquetView {
+    type Event = ();
+
+    fn tab_icon(&self, _window: &Window, _cx: &App) -> Option<Icon> {
+        Some(Icon::new(IconName::Table))
+    }
+
+    fn tab_content_text(&self, _detail: usize, cx: &App) -> SharedString {
+        self.item
+            .read(cx)
+            .project_path
+            .path
+            .file_name()
+            .map(|name| SharedString::from(name.to_string()))
+            .unwrap_or_else(|| "Parquet".into())
+    }
+
+    fn tab_tooltip_text(&self, cx: &App) -> Option<SharedString> {
+        Some(
+            self.item
+                .read(cx)
+                .project_path
+                .path
+                .as_unix_str()
+                .to_string()
+                .into(),
+        )
+    }
+
+    fn for_each_project_item(
+        &self,
+        cx: &App,
+        f: &mut dyn FnMut(EntityId, &dyn project::ProjectItem),
+    ) {
+        f(self.item.entity_id(), self.item.read(cx))
+    }
+
+    fn buffer_kind(&self, _: &App) -> ItemBufferKind {
+        ItemBufferKind::Singleton
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use crate::types::DataRow;
