{
  "name": "zed-parquet-viewer-server",
  "version": "0.1.0",
  "private": true,
  "description": "MCP server that lets Zed's agent inspect, query, and convert Parquet/CSV files",
  "license": "Apache-2.0",
  "type": "module",
  "main": "src/index.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "esbuild src/index.js --bundle --platform=node --target=node20 --format=esm --legal-comments=eof --minify --outfile=dist/server.js",
    "test": "node --test",
    "check-bundle": "npm run build && git diff --exit-code -- dist/server.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "csv-parse": "7.0.3",
    "hyparquet": "1.33.0",
    "hyparquet-compressors": "1.1.3",
    "squirreling": "0.17.9",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "hyparquet-writer": "0.18.0"
  }
}
